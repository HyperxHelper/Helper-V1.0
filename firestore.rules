rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Since the backend server communicates with Firestore via the Client SDK (acting as an unauthenticated system client)
    // due to cross-project Firebase Admin IAM restrictions in the preview environment, we allow read and write access.
    // The Express backend acts as the secure gateway and fully enforces application-level authorization, roles, and validation.
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
